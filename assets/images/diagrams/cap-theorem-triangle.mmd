graph TB
    subgraph "Under a partition, P is not optional"
        C[Consistency]
        A[Availability]
        P[Partition tolerance]
        C --- A
        A --- P
        P --- C
    end

    subgraph "CP: refuse rather than guess"
        CP1[etcd · ZooKeeper]
        CP2[Regional DynamoDB writes]
        CP3[Aurora storage quorum]
    end

    subgraph "AP: answer rather than wait"
        AP1[Cassandra · 2007 Dynamo paper]
        AP2[DynamoDB Global Tables MREC]
    end

    subgraph "Not a distributed third option"
        CA1[Single-node PostgreSQL]
    end

    style C fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style A fill:#e8f5e8,stroke:#2e7d32,stroke-width:2px
    style P fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style CP2 fill:#fff3e0,stroke:#ef6c00
    style AP2 fill:#e3f2fd,stroke:#1565c0
    style CA1 fill:#f5f5f5,stroke:#9e9e9e
