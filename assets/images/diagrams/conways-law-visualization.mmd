graph LR
    subgraph ORG["Organization"]
        FE[Frontend team]
        BE[Backend team]
        DB[Database team]
    end

    subgraph SYS["Architecture that results"]
        BFF[BFF service]
        LOGIC[Business-logic service]
        DATA[Data service + shared schema]
    end

    FE -->|"mirrors"| BFF
    BE -->|"mirrors"| LOGIC
    DB -->|"mirrors"| DATA
    BFF --> LOGIC --> DATA

    style FE fill:#FFE082,stroke:#F57C00,stroke-width:2px
    style BE fill:#FFE082,stroke:#F57C00,stroke-width:2px
    style DB fill:#FFE082,stroke:#F57C00,stroke-width:2px
    style BFF fill:#90CAF9,stroke:#1565C0,stroke-width:2px
    style LOGIC fill:#90CAF9,stroke:#1565C0,stroke-width:2px
    style DATA fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px
